{
  "name": "@node-agent-runtime/policy",
  "version": "0.3.0",
  "description": "C5 policy package of the Agent runtime: authorization decisions (allow/deny/ask) — DefaultPermissionPolicy matrix, PermissionManager approval flow with timeout and always-allowlist, composable policies. Depends on @node-agent-runtime/types and (type-only) @node-agent-runtime/sandbox.",
  "license": "Apache-2.0",
  "author": {
    "name": "wangzhiyong",
    "email": "y1378379002@gmail.com",
    "url": "https://github.com/0end1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0end1/node-agent-runtime.git",
    "directory": "packages/policy"
  },
  "homepage": "https://github.com/0end1/node-agent-runtime",
  "bugs": {
    "url": "https://github.com/0end1/node-agent-runtime/issues"
  },
  "keywords": [
    "node-agent-runtime",
    "agent",
    "policy",
    "permissions",
    "approval"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@node-agent-runtime/sandbox": "^0.3.0"
  },
  "devDependencies": {
    "@node-agent-runtime/types": "^0.3.0"
  },
  "peerDependencies": {
    "@node-agent-runtime/types": "^0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  }
}
