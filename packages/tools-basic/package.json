    "tools",
    "calculator",
    "demo"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@agent-runtime/core": "^0.2.0",
    "@agent-runtime/types": "^0.2.0"
  },
  "peerDependencies": {
    "@agent-runtime/core": "^0.2.0",
    "@agent-runtime/types": "^0.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
