{
  "name": "@agent-runtime/sandbox",
  "version": "0.2.0",
  "description": "C4 sandbox package of the Agent runtime: run-level execution boundary — SandboxMode tiers, SandboxScope and the in-process LocalSandbox (path/network/time enforcement, sandbox:write visibility). Depends only on @agent-runtime/types.",
  "license": "MIT",
  "author": {
    "name": "wangzhiyong",
    "email": "y1378379002@gmail.com",
    "url": "https://github.com/0end1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0end1/nodeRuntime.git",
    "directory": "packages/sandbox"
  },
  "homepage": "https://github.com/0end1/nodeRuntime",
  "bugs": {
    "url": "https://github.com/0end1/nodeRuntime/issues"
  },
  "keywords": [
    "agent-runtime",
    "agent",
    "sandbox",
    "permissions",
    "security"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@agent-runtime/types": "^0.2.0"
  },
  "peerDependencies": {
    "@agent-runtime/types": "^0.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  }
}
