  "description": "A lightweight, zero-dependency Agent runtime for TypeScript/Node.js: event loop, tool-calling, multi-step reasoning and pluggable LLM providers.",
  "private": true,
  "type": "module",
  "author": {
    "name": "wangzhiyong",
