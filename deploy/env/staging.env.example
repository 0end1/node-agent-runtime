# 预发环境：对外监听 → 必须设令牌（P3.5），跨站按白名单放行

HOST=0.0.0.0
PORT=8787
AGENT_LOG_LEVEL=info

# 鉴权与跨站：非 loopback 监听无令牌会拒绝启动
AGENT_API_TOKEN=replace-me-with-a-long-random-token
AGENT_CORS_ALLOW_ORIGINS=https://staging-console.example.com

# 沙箱与预算（P3.4 / P3.7）
AGENT_SANDBOX_NETWORK=deny
AGENT_LIMIT_MAX_STEPS=20
AGENT_LIMIT_MAX_DURATION_MS=120000

# 模型
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
