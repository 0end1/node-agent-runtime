{
  "name": "@agent-runtime/types",
  "version": "0.2.0",
  "description": "C1 shared leaf package of the Agent runtime: message/tool-call contracts, JSON Schema subset validator and zero-IO pure helpers. No internal dependencies.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/schema.test.ts"
  }
}
