{
  "name": "@node-agent-runtime/mcp",
  "version": "0.4.0",
  "description": "C6 MCP adapter package of the Agent runtime: JSON-RPC 2.0 client, stdio / streamable-HTTP transports and McpRegistry that materializes remote MCP tools as local ToolDefinitions. Depends on @node-agent-runtime/core for the tool contract (C4 decision: contract stays in core); the core never imports this package.",
  "license": "Apache-2.0",
  "author": {
    "name": "wangzhiyong",
    "email": "y1378379002@gmail.com",
    "url": "https://github.com/0end1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0end1/node-agent-runtime.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/0end1/node-agent-runtime",
  "bugs": {
    "url": "https://github.com/0end1/node-agent-runtime/issues"
  },
  "keywords": [
    "node-agent-runtime",
    "agent",
    "mcp",
    "json-rpc",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@node-agent-runtime/core": "^0.4.0",
    "@node-agent-runtime/types": "^0.4.0"
  },
  "peerDependencies": {
    "@node-agent-runtime/core": "^0.4.0",
    "@node-agent-runtime/types": "^0.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  }
}
