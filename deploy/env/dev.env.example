# 开发环境：仅本机可达，免令牌（P3.5 loopback 便利模式）
# 用法：cp deploy/env/dev.env.example .env && npm run demo:web

HOST=127.0.0.1
PORT=8787
AGENT_LOG_LEVEL=debug

# 模型：留空则用内置 MockProvider（免密钥离线演示）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 数据目录（默认 ./.runtime-data）
# RUNTIME_DATA=.runtime-data
