{
  "name": "@agent-runtime/core",
  "version": "0.2.0",
  "description": "C2 engine package of the Agent runtime: AgentRuntime run loop, agent recipe, run context, EventBus, tool/model contracts and the zero-dependency MemoryStorage/FileStorage, plus a facade re-exporting types/memory/artifact/sandbox/policy. Session & provider backends live in sibling packages. Depends only on @agent-runtime/types.",
  "license": "MIT",
  "author": {
    "name": "wangzhiyong",
    "email": "y1378379002@gmail.com",
    "url": "https://github.com/0end1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0end1/nodeRuntime.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/0end1/nodeRuntime",
  "bugs": {
    "url": "https://github.com/0end1/nodeRuntime/issues"
  },
  "keywords": [
    "agent-runtime",
    "agent",
    "runtime",
    "llm",
    "tool-calling",
    "events"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@agent-runtime/types": "^0.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  }
}
