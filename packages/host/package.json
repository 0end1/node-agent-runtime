{
  "name": "@agent-runtime/host",
  "version": "0.2.0",
  "description": "C8 host package of the Agent runtime: Session/Task/Run lifecycle (SessionManager) plus the assembled product surface (memory + artifact + sandbox + policy). Depends on @agent-runtime/core and the C3~C5 packages; the core never imports this package.",
  "license": "MIT",
  "author": {
    "name": "wangzhiyong",
    "email": "y1378379002@gmail.com",
    "url": "https://github.com/0end1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0end1/nodeRuntime.git",
    "directory": "packages/host"
  },
  "homepage": "https://github.com/0end1/nodeRuntime",
  "bugs": {
    "url": "https://github.com/0end1/nodeRuntime/issues"
  },
  "keywords": [
    "agent-runtime",
    "agent",
    "host",
    "session",
    "orchestration"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@agent-runtime/memory": "^0.2.0",
    "@agent-runtime/policy": "^0.2.0",
    "@agent-runtime/sandbox": "^0.2.0"
  },
  "devDependencies": {
    "@agent-runtime/core": "^0.2.0",
    "@agent-runtime/types": "^0.2.0"
  },
  "peerDependencies": {
    "@agent-runtime/core": "^0.2.0",
    "@agent-runtime/types": "^0.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  }
}
