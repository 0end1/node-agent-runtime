{
  "name": "@agent-runtime/mcp",
  "version": "0.2.0",
  "description": "C6 MCP adapter package of the Agent runtime: JSON-RPC 2.0 client, stdio / streamable-HTTP transports and McpRegistry that materializes remote MCP tools as local ToolDefinitions. Depends on @agent-runtime/core for the tool contract (C4 decision: contract stays in core); the core never imports this package.",
  "license": "MIT",
  "author": {
    "name": "wangzhiyong",
    "email": "y1378379002@gmail.com",
    "url": "https://github.com/0end1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0end1/nodeRuntime.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/0end1/nodeRuntime",
  "bugs": {
    "url": "https://github.com/0end1/nodeRuntime/issues"
  },
  "keywords": [
    "agent-runtime",
    "agent",
    "mcp",
    "json-rpc",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@agent-runtime/core": "^0.2.0",
    "@agent-runtime/types": "^0.2.0"
  },
  "peerDependencies": {
    "@agent-runtime/core": "^0.2.0",
    "@agent-runtime/types": "^0.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  }
}
