{
  "name": "@node-agent-runtime/artifact",
  "version": "0.4.0",
  "description": "Artifact package of the Agent runtime: ArtifactManager — metadata rows in the Storage doc domain plus payloads in the blob domain (text/file/chart/url), cascaded cleanup per session. Split out of the memory package (M6 P1 review, P1) so each package matches one concern.",
  "license": "Apache-2.0",
  "author": {
    "name": "wangzhiyong",
    "email": "y1378379002@gmail.com",
    "url": "https://github.com/0end1"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0end1/node-agent-runtime.git",
    "directory": "packages/artifact"
  },
  "homepage": "https://github.com/0end1/node-agent-runtime",
  "bugs": {
    "url": "https://github.com/0end1/node-agent-runtime/issues"
  },
  "keywords": [
    "node-agent-runtime",
    "agent",
    "artifact",
    "blob",
    "storage"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@node-agent-runtime/types": "^0.4.0"
  },
  "peerDependencies": {
    "@node-agent-runtime/types": "^0.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  }
}
