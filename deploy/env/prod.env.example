# 生产环境：对外监听 + 令牌 + 跨站白名单 + 运行预算 + MCP 白名单
# 真实密钥请用 env_file / secrets 注入，切勿提交到仓库。

HOST=0.0.0.0
PORT=8787
AGENT_LOG_LEVEL=warn

# ---- 鉴权与跨站（P3.5）----
AGENT_API_TOKEN=replace-me-with-a-long-random-token
AGENT_CORS_ALLOW_ORIGINS=https://console.example.com

# ---- 模型（密钥只经环境注入，P3.8）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- 沙箱（P3.7）：默认禁网；确需外网改 allowlist 并列出域名 ----
AGENT_SANDBOX_NETWORK=deny
# AGENT_SANDBOX_NETWORK=allowlist
# AGENT_SANDBOX_NETWORK_ALLOWLIST=https://api.openai.com

# ---- 运行预算：超限产 run:error（P3.4）----
AGENT_LIMIT_MAX_STEPS=20
AGENT_LIMIT_MAX_DURATION_MS=120000
AGENT_LIMIT_MAX_COST_USD=1
AGENT_RATE_TOOL_MAX_CALLS=30
AGENT_RATE_TOOL_WINDOW_MS=60000

# ---- MCP 供应链防护（P3.6）----
# AGENT_MCP_HTTP_ALLOWLIST=https://mcp.example.com
AGENT_MCP_STDIO_TIMEOUT_MS=5000

# ---- 特性开关 ----
AGENT_FEATURE_MCP=true
AGENT_FEATURE_SQLITE=true
AGENT_FEATURE_ARTIFACTS=true

# ---- 数据目录 ----
# RUNTIME_DATA=.runtime-data
